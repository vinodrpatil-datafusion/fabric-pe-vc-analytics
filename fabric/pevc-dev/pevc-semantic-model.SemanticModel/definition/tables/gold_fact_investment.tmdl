table gold_fact_investment
	lineageTag: af169e54-a302-42cb-8a1b-d0f32c985d97
	sourceLineageTag: [dbo].[gold_fact_investment]

	measure 'Total Invested' = SUM(gold_fact_investment[participation_amount])
		lineageTag: 15d70201-bc64-405b-b1ca-7bc9d3f6fb39

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'NAV (proxy)' =
			
			SUMX(
			    gold_fact_investment,
			    IF(
			        gold_fact_investment[is_realized],
			        gold_fact_investment[participation_amount] * gold_fact_investment[realised_return_multiple],
			        gold_fact_investment[participation_amount]
			    )
			)
		lineageTag: 82243d35-9d87-462a-aa15-f7b4e5e7d2a2

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cost-Weighted Avg Years Held' =
			
			DIVIDE(
			    SUMX(
			        gold_fact_investment,
			        gold_fact_investment[participation_amount] *
			        DATEDIFF(
			            gold_fact_investment[effective_date],
			            IF(gold_fact_investment[is_realized], gold_fact_investment[exit_date], TODAY()),
			            DAY
			        ) / 365.25
			    ),
			    [Total Invested]
			)
		lineageTag: dc88955c-dc22-42fa-beab-9b622d2427a4

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MOIC = DIVIDE([NAV (proxy)], [Total Invested])
		formatString: 0.00"x"
		lineageTag: 915790f9-b6fc-4647-885d-91d1477aa7e2

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'IRR (proxy)' =
			
			VAR PooledMOIC = [MOIC]
			VAR Years = [Cost-Weighted Avg Years Held]
			RETURN
			IF(AND(NOT ISBLANK(PooledMOIC), Years > 0), PooledMOIC ^ (1 / Years) - 1, BLANK())
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 31602d65-4777-4484-ad47-5b20be718d3d

		changedProperty = Name

		changedProperty = FormatString

	measure 'Sector Concentration %' =
			
			DIVIDE([Total Invested], CALCULATE([Total Invested], ALL(gold_dim_company[sector_group])))
		lineageTag: c6fb1e3d-faa5-4f63-949e-04a2a2ae5997

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

