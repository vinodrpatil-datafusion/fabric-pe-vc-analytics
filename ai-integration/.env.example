# Copy to .env (git-ignored) and fill in your own values. Never commit real
# endpoints/keys -- same placeholder discipline as the notebooks' REFERENCE_FILES
# ABFS paths.

# Azure AI Foundry project endpoint (Foundry portal -> your project -> Overview).
AZURE_AI_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>

# Model deployment name used for chat/completions in later stages (Stage C+).
AZURE_AI_MODEL_DEPLOYMENT=<your-deployment-name>

AZURE_AI_EMBEDDING_DEPLOYMENT=<your-embedding-deployment-name>


# Name to give/reuse for the vector store this script creates. Change only if
# you want a second, separate index alongside the WS5 one.
LP_VECTOR_STORE_NAME=<your-vector-store-name>

# Stage C (structured_agent.py): pevc-dev workspace ID and pevc-semantic-model
# dataset ID, used for the Power BI REST executeQueries DAX call. Find via
# Fabric portal dataset settings, or GET https://api.powerbi.com/v1.0/myorg/groups
# with a Power BI-scoped token for the identity that has access to pevc-dev
# (may be a different identity than the one with Foundry access -- see
# structured_agent.py's module docstring).
POWERBI_WORKSPACE_ID=<pevc-dev-workspace-id>
POWERBI_DATASET_ID=<pevc-semantic-model-dataset-id>

# Account the agent scripts (structured_agent.py, document_agent.py,
# fusion_agent.py) should authenticate as -- must have RBAC on both the
# Foundry project and the Fabric workspace above (see agent_common.py).
# Pre-fills the browser sign-in prompt; never commit a real account name
# here, only in your git-ignored .env.
AGENT_LOGIN_HINT=<your-account-with-access-to-both-resources>
