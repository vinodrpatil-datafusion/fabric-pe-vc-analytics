{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deal",
  "description": "An investment or divestment event between a fund and a portfolio company.",
  "type": "object",
  "required": ["deal_id", "fund_id", "company_id", "deal_type", "deal_date", "amount_m", "ownership_pct", "currency"],
  "properties": {
    "deal_id":               { "type": "string", "pattern": "^DEAL-\\d{6}$" },
    "fund_id":               { "type": "string", "pattern": "^FUND-\\d{4}$" },
    "company_id":            { "type": "string", "pattern": "^CO-\\d{5}$" },
    "deal_type":             { "enum": ["Primary", "Follow-On", "Exit"] },
    "deal_date":             { "type": "string", "format": "date" },
    "amount_m":              { "type": "number", "minimum": 0 },
    "ownership_pct":         { "type": "number", "minimum": 0, "maximum": 100 },
    "valuation_pre_money_m": { "type": ["number", "null"], "minimum": 0 },
    "valuation_post_money_m":{ "type": ["number", "null"], "minimum": 0 },
    "currency":              { "enum": ["USD", "EUR", "GBP"] },
    "_record_id":     { "type": "string", "format": "uuid" },
    "_source_system": { "type": "string" },
    "_source_file":   { "type": "string" },
    "_ingestion_ts":  { "type": "string", "format": "date-time" },
    "_batch_id":      { "type": "string", "format": "uuid" },
    "_data_version":  { "type": "string" },
    "_is_synthetic":  { "type": "boolean", "const": true }
  }
}
