{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PortfolioCompany",
  "description": "An investee company held by a fund.",
  "type": "object",
  "required": ["company_id", "company_name", "fund_id", "sector", "country", "founded_year", "entry_date", "status"],
  "properties": {
    "company_id":   { "type": "string", "pattern": "^CO-\\d{5}$" },
    "company_name": { "type": "string" },
    "fund_id":      { "type": "string", "pattern": "^FUND-\\d{4}$" },
    "sector":       { "type": "string" },
    "country":      { "type": "string" },
    "founded_year": { "type": "integer", "minimum": 1990 },
    "entry_date":   { "type": "string", "format": "date" },
    "exit_date":    { "type": ["string", "null"], "format": "date" },
    "status":       { "enum": ["Active", "Exited", "Written Off"] },
    "_record_id":     { "type": "string", "format": "uuid" },
    "_source_system": { "type": "string" },
    "_source_file":   { "type": "string" },
    "_ingestion_ts":  { "type": "string", "format": "date-time" },
    "_batch_id":      { "type": "string", "format": "uuid" },
    "_data_version":  { "type": "string" },
    "_is_synthetic":  { "type": "boolean", "const": true }
  }
}
