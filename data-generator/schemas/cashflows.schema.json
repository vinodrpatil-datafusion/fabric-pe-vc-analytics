{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cashflow",
  "description": "A capital call or distribution event at the fund level, attributable to a company.",
  "type": "object",
  "required": ["cashflow_id", "fund_id", "company_id", "cashflow_date", "cashflow_type", "amount_m", "currency"],
  "properties": {
    "cashflow_id":    { "type": "string", "pattern": "^CF-\\d{7}$" },
    "fund_id":        { "type": "string", "pattern": "^FUND-\\d{4}$" },
    "company_id":     { "type": "string", "pattern": "^CO-\\d{5}$" },
    "cashflow_date":  { "type": "string", "format": "date" },
    "cashflow_type":  { "enum": ["Capital Call", "Distribution"] },
    "amount_m":       { "type": "number", "minimum": 0 },
    "currency":       { "enum": ["USD", "EUR", "GBP"] },
    "_record_id":     { "type": "string", "format": "uuid" },
    "_source_system": { "type": "string" },
    "_source_file":   { "type": "string" },
    "_ingestion_ts":  { "type": "string", "format": "date-time" },
    "_batch_id":      { "type": "string", "format": "uuid" },
    "_data_version":  { "type": "string" },
    "_is_synthetic":  { "type": "boolean", "const": true }
  }
}
