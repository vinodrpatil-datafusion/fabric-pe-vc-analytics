{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LimitedPartner",
  "description": "An investor in one or more funds.",
  "type": "object",
  "required": ["lp_id", "lp_name", "lp_type", "domicile", "aum_m_usd"],
  "properties": {
    "lp_id":     { "type": "string", "pattern": "^LP-\\d{5}$" },
    "lp_name":   { "type": "string" },
    "lp_type":   { "enum": ["Pension Fund", "Sovereign Wealth Fund", "Endowment", "Family Office", "Fund of Funds", "Insurance"] },
    "domicile":  { "type": "string" },
    "aum_m_usd": { "type": "number", "minimum": 0 },
    "_record_id":     { "type": "string", "format": "uuid" },
    "_source_system": { "type": "string" },
    "_source_file":   { "type": "string" },
    "_ingestion_ts":  { "type": "string", "format": "date-time" },
    "_batch_id":      { "type": "string", "format": "uuid" },
    "_data_version":  { "type": "string" },
    "_is_synthetic":  { "type": "boolean", "const": true }
  }
}
