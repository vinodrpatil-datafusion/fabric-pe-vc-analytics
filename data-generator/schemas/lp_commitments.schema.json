{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LPCommitment",
  "description": "An LP's capital commitment to a specific fund.",
  "type": "object",
  "required": ["commitment_id", "lp_id", "fund_id", "commitment_m", "currency"],
  "properties": {
    "commitment_id": { "type": "string", "pattern": "^COMM-\\d{7}$" },
    "lp_id":         { "type": "string", "pattern": "^LP-\\d{5}$" },
    "fund_id":       { "type": "string", "pattern": "^FUND-\\d{4}$" },
    "commitment_m":  { "type": "number", "minimum": 0 },
    "currency":      { "enum": ["USD", "EUR", "GBP"] },
    "_record_id":     { "type": "string", "format": "uuid" },
    "_source_system": { "type": "string" },
    "_source_file":   { "type": "string" },
    "_ingestion_ts":  { "type": "string", "format": "date-time" },
    "_batch_id":      { "type": "string", "format": "uuid" },
    "_data_version":  { "type": "string" },
    "_is_synthetic":  { "type": "boolean", "const": true }
  }
}
